
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:osk="clr-namespace:Avalonia.DrmKit.OnScreenKeyboard;assembly=Avalonia.DrmKit"
        x:Class="Avalonia.DrmKit.Sample.Views.MainWindow"
        Width="900" Height="600" Title="Avalonia.DrmKit Sample">
  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,*">
    <TextBlock Grid.ColumnSpan="2" Margin="12" FontSize="16" TextWrapping="Wrap">
      <Run Text="Проверка DrmKit:"/><LineBreak/>
      <Run Text="— Софт-курсор (DRM)."/><LineBreak/>
      <Run Text="— Экранная клавиатура-шторка (без Popup)."/><LineBreak/>
      <Run Text="— Сырая клава (DRM) с раскладками EN/RU и Alt+Shift."/>
    </TextBlock>

    <StackPanel Grid.Row="1" Grid.Column="0" Margin="12" Spacing="8">
      <TextBlock Text="TextBox c автопопапом клавиатуры"/>
      <TextBox x:Name="FirstTb" osk:KeyboardOverlay.IsEnabled="True" PlaceholderText="Нажми сюда"/>
      <TextBlock Margin="0,12,0,0" Text="Ещё один TextBox"/>
      <TextBox osk:KeyboardOverlay.IsEnabled="True" PlaceholderText="И сюда тоже"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Grid.Column="1" Margin="12" Spacing="8">
      <Button Content="Открыть второе окно" Click="OnOpenSecondWindow"/>
      <TextBlock Text="Нажми — проверим, что софт-курсор прикрепляется и к новым окнам."/>
    </StackPanel>
  </Grid>
</Window>
