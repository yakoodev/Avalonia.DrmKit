
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:osk="clr-namespace:Avalonia.DrmKit.OnScreenKeyboard;assembly=Avalonia.DrmKit"
        x:Class="Avalonia.DrmKit.Sample.Views.SecondWindow"
        Width="400" Height="300" Title="Второе окно">
  <StackPanel Margin="12" Spacing="8">
    <TextBlock Text="Второе окно"/>
    <TextBox Watermark="Проверь клавиатуру и курсор" osk:KeyboardOverlay.IsEnabled="True"/>
  </StackPanel>
</Window>
