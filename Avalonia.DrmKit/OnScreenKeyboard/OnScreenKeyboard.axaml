<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Avalonia.DrmKit.OnScreenKeyboard"
             x:Class="Avalonia.DrmKit.OnScreenKeyboard.OnScreenKeyboard">

  <!-- Привязка к теме приложения -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <!-- Светлая тема -->
        <ResourceDictionary x:Key="Light">
          <!-- фон панели клавиатуры -->
          <SolidColorBrush x:Key="Osk.Background" Color="#FFF5F5F5"/>
          <SolidColorBrush x:Key="Osk.Border"     Color="#33000000"/>

          <!-- фон/бордер/текст обычных клавиш -->
          <SolidColorBrush x:Key="Osk.KeyBackground"          Color="#FFFFFFFF"/>
          <SolidColorBrush x:Key="Osk.KeyBorder"              Color="#33000000"/>
          <SolidColorBrush x:Key="Osk.KeyForeground"          Color="#202020"/>

          <!-- основные (Enter/Cancel/etc.) -->
          <SolidColorBrush x:Key="Osk.PrimaryKeyBackground"   Color="#FF4A76E8"/>
          <SolidColorBrush x:Key="Osk.PrimaryKeyBorder"       Color="#FF4A76E8"/>
          <SolidColorBrush x:Key="Osk.PrimaryKeyForeground"   Color="#FFFFFFFF"/>

          <!-- активные переключатели (CAPS) -->
          <SolidColorBrush x:Key="Osk.ActiveKeyBackground"    Color="#FFD0E8FF"/>

          <!-- Наведение/нажатие: НЕПРОЗРАЧНЫЕ цвета. Раньше нажатие делало клавишу полупрозрачной
               (Opacity), а тема Fluent подменяла её фон своим полупрозрачным — сквозь клавишу было
               видно экран под клавиатурой. -->
          <SolidColorBrush x:Key="Osk.KeyHoverBackground"          Color="#FFEDEDED"/>
          <SolidColorBrush x:Key="Osk.KeyPressedBackground"        Color="#FFD4D4D4"/>
          <SolidColorBrush x:Key="Osk.PrimaryKeyHoverBackground"   Color="#FF3F6AD8"/>
          <SolidColorBrush x:Key="Osk.PrimaryKeyPressedBackground" Color="#FF3358BC"/>

          <!-- Новые варианты (12.1): цвета по умолчанию — как у приложения IProSimulator; приложение может
               переопределить ключи Osk.M.* у себя. -->
          <SolidColorBrush x:Key="Osk.M.Panel"        Color="#FFF6F8FF"/>
          <SolidColorBrush x:Key="Osk.M.PanelBorder"  Color="#FFDDE3F3"/>
          <SolidColorBrush x:Key="Osk.M.Key"          Color="#FFFFFFFF"/>
          <SolidColorBrush x:Key="Osk.M.KeyBorder"    Color="#FFDDE3F3"/>
          <SolidColorBrush x:Key="Osk.M.KeyPressed"   Color="#FFE3EAFA"/>
          <SolidColorBrush x:Key="Osk.M.Mod"          Color="#FFEDF2FF"/>
          <SolidColorBrush x:Key="Osk.M.ModPressed"   Color="#FFDCE5FA"/>
          <SolidColorBrush x:Key="Osk.M.Text"         Color="#FF0B0D12"/>
          <SolidColorBrush x:Key="Osk.M.Text2"        Color="#FF3A4254"/>
          <SolidColorBrush x:Key="Osk.M.On"           Color="#FFDFF8FD"/>
          <SolidColorBrush x:Key="Osk.M.Accent"       Color="#FF22C3E6"/>
          <SolidColorBrush x:Key="Osk.M.Go"           Color="#FF9BEFFD"/>
          <SolidColorBrush x:Key="Osk.M.GoPressed"    Color="#FF6FE2F7"/>
          <SolidColorBrush x:Key="Osk.M.GoText"       Color="#FF0B0D12"/>
        </ResourceDictionary>

        <!-- Тёмная тема -->
        <ResourceDictionary x:Key="Dark">
          <!-- Непрозрачный: полупрозрачный фон показывал экран сквозь клавиатуру. -->
          <SolidColorBrush x:Key="Osk.Background"             Color="#FF101010"/>
          <SolidColorBrush x:Key="Osk.Border"                 Color="#40FFFFFF"/>

          <SolidColorBrush x:Key="Osk.KeyBackground"          Color="#303030"/>
          <SolidColorBrush x:Key="Osk.KeyBorder"              Color="#55FFFFFF"/>
          <SolidColorBrush x:Key="Osk.KeyForeground"          Color="#FFFFFFFF"/>

          <SolidColorBrush x:Key="Osk.PrimaryKeyBackground"   Color="#FF3050A0"/>
          <SolidColorBrush x:Key="Osk.PrimaryKeyBorder"       Color="#FF80A0FF"/>
          <SolidColorBrush x:Key="Osk.PrimaryKeyForeground"   Color="#FFFFFFFF"/>

          <SolidColorBrush x:Key="Osk.ActiveKeyBackground"    Color="#FF4060C0"/>

          <SolidColorBrush x:Key="Osk.KeyHoverBackground"          Color="#FF3A3A3A"/>
          <SolidColorBrush x:Key="Osk.KeyPressedBackground"        Color="#FF4A4A4A"/>
          <SolidColorBrush x:Key="Osk.PrimaryKeyHoverBackground"   Color="#FF3858AC"/>
          <SolidColorBrush x:Key="Osk.PrimaryKeyPressedBackground" Color="#FF26448C"/>

          <SolidColorBrush x:Key="Osk.M.Panel"        Color="#FF131B2A"/>
          <SolidColorBrush x:Key="Osk.M.PanelBorder"  Color="#FF2B3A57"/>
          <SolidColorBrush x:Key="Osk.M.Key"          Color="#FF1A2540"/>
          <SolidColorBrush x:Key="Osk.M.KeyBorder"    Color="#FF2B3A57"/>
          <SolidColorBrush x:Key="Osk.M.KeyPressed"   Color="#FF26355A"/>
          <SolidColorBrush x:Key="Osk.M.Mod"          Color="#FF0F1626"/>
          <SolidColorBrush x:Key="Osk.M.ModPressed"   Color="#FF1A2540"/>
          <SolidColorBrush x:Key="Osk.M.Text"         Color="#FFE6ECFF"/>
          <SolidColorBrush x:Key="Osk.M.Text2"        Color="#FFC3CCE8"/>
          <SolidColorBrush x:Key="Osk.M.On"           Color="#FF16485A"/>
          <SolidColorBrush x:Key="Osk.M.Accent"       Color="#FF22D3EE"/>
          <SolidColorBrush x:Key="Osk.M.Go"           Color="#FF0E7490"/>
          <SolidColorBrush x:Key="Osk.M.GoPressed"    Color="#FF155E75"/>
          <SolidColorBrush x:Key="Osk.M.GoText"       Color="#FFFFFFFF"/>
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>

    <!-- Контейнер клавиатуры -->
    <Style Selector="local|OnScreenKeyboard">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="4"/>

      <Setter Property="Background" Value="{DynamicResource Osk.Background}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Osk.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Базовый стиль для всех клавиш -->
    <Style Selector="local|OnScreenKeyboard Button.osk-button">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="Padding" Value="6,4"/>

      <!-- Центрируем текст -->
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>

      <!-- Растяжение по ячейке -->
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>

      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BorderThickness" Value="1"/>

      <!-- Цвета берём из ресурсов OSK -->
      <Setter Property="Background" Value="{DynamicResource Osk.KeyBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Osk.KeyBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.KeyForeground}"/>
    </Style>

    <!-- Основные клавиши (Enter / Cancel / Backspace / Del / Eng / Rus) -->
    <Style Selector="local|OnScreenKeyboard Button.osk-button.primary">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="{DynamicResource Osk.PrimaryKeyBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Osk.PrimaryKeyBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.PrimaryKeyForeground}"/>
    </Style>

    <!-- Активные переключатели (CAPS) -->
    <Style Selector="local|OnScreenKeyboard Button.osk-button.active">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Background" Value="{DynamicResource Osk.ActiveKeyBackground}"/>
    </Style>

    <!-- «Широкие» кнопки (Space, Caps) -->
    <Style Selector="local|OnScreenKeyboard Button.osk-button.wide">
      <Setter Property="FontSize" Value="16"/>
    </Style>

    <!-- Hover / Pressed -->
    <Style Selector="local|OnScreenKeyboard Button.osk-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Osk.KeyHoverBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Osk.KeyBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.KeyForeground}"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard Button.osk-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Osk.KeyPressedBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Osk.KeyBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.KeyForeground}"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard Button.osk-button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Osk.PrimaryKeyHoverBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Osk.PrimaryKeyBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.PrimaryKeyForeground}"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard Button.osk-button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Osk.PrimaryKeyPressedBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Osk.PrimaryKeyBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.PrimaryKeyForeground}"/>
    </Style>

    <!-- ===== Новые варианты (OnScreenKeyboardStyle, 12.1): класс modern ставит код ===== -->
    <Style Selector="local|OnScreenKeyboard.modern">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="12,8,12,12"/>
      <Setter Property="Background" Value="{DynamicResource Osk.M.Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Osk.M.PanelBorder}"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="CornerRadius" Value="18,18,0,0"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard TextBlock.osk-strip">
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.M.Text}"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard TextBlock.osk-strip Run.osk-hint">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.M.Text2}"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard Button.osk-key">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource Osk.M.Key}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Osk.M.KeyBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.M.Text}"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard Button.osk-key.digit">
      <Setter Property="FontSize" Value="26"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard Button.osk-key.mod">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Background" Value="{DynamicResource Osk.M.Mod}"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.M.Text2}"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard Button.osk-key.on">
      <Setter Property="Background" Value="{DynamicResource Osk.M.On}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Osk.M.Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.M.Text}"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard Button.osk-key.go">
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Background" Value="{DynamicResource Osk.M.Go}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Osk.M.Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.M.GoText}"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard Button.osk-key.quiet">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.M.Text2}"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard Button.osk-key.pill">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Padding" Value="16,4"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.M.Text2}"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard Button.osk-key Path.osk-icon">
      <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard Button.osk-key Path.osk-icon-filled">
      <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}"/>
      <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}"/>
    </Style>
    <!-- Наведение/нажатие: непрозрачные цвета (Fluent подменяет фон своим полупрозрачным). -->
    <Style Selector="local|OnScreenKeyboard Button.osk-key:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Osk.M.Key}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Osk.M.KeyBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.M.Text}"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard Button.osk-key:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Osk.M.KeyPressed}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Osk.M.Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.M.Text}"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard Button.osk-key.mod:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Osk.M.Mod}"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.M.Text2}"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard Button.osk-key.mod:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Osk.M.ModPressed}"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.M.Text}"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard Button.osk-key.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Osk.M.On}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Osk.M.Accent}"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard Button.osk-key.go:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Osk.M.Go}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Osk.M.Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.M.GoText}"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard Button.osk-key.go:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Osk.M.GoPressed}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Osk.M.Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.M.GoText}"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard Button.osk-key.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.M.Text2}"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard Button.osk-key.quiet:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Osk.M.Mod}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.M.Text}"/>
    </Style>

  </UserControl.Styles>

  <!-- Background="Transparent": без фона зазоры между клавишами не ловят касание, оно уходит
       на экран под клавиатурой, фокус теряется — и клавиатура закрывается. -->
  <Panel Background="Transparent">
  <Grid x:Name="KeysGrid"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
        ColumnDefinitions="*"
        Background="Transparent">
    <UniformGrid Rows="1" Columns="9"  Grid.Row="0" x:Name="Row0" />
    <UniformGrid Rows="1" Columns="10" Grid.Row="1" x:Name="Row1" />
    <UniformGrid Rows="1" Columns="10" Grid.Row="2" x:Name="Row2" />
    <UniformGrid Rows="1" Columns="9"  Grid.Row="3" x:Name="Row3" />
    <UniformGrid Rows="1" Columns="9"  Grid.Row="4" x:Name="Row4" />
    <UniformGrid Rows="1" Columns="5"  Grid.Row="5" x:Name="Row5" />
  </Grid>
  <!-- Новые варианты строятся кодом (OnScreenKeyboard.Modern.cs). -->
  <ContentControl x:Name="ModernRoot" IsVisible="False" Focusable="False" IsTabStop="False"/>
  </Panel>
</UserControl>
