<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Avalonia.DrmKit.OnScreenKeyboard"
             x:Class="Avalonia.DrmKit.OnScreenKeyboard.OnScreenKeyboard">

  <!-- Привязка к теме приложения -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <!-- Светлая тема -->
        <ResourceDictionary x:Key="Light">
          <!-- фон панели клавиатуры -->
          <SolidColorBrush x:Key="Osk.Background" Color="#FFF5F5F5"/>
          <SolidColorBrush x:Key="Osk.Border"     Color="#33000000"/>

          <!-- фон/бордер/текст обычных клавиш -->
          <SolidColorBrush x:Key="Osk.KeyBackground"          Color="#FFFFFFFF"/>
          <SolidColorBrush x:Key="Osk.KeyBorder"              Color="#33000000"/>
          <SolidColorBrush x:Key="Osk.KeyForeground"          Color="#202020"/>

          <!-- основные (Enter/Cancel/etc.) -->
          <SolidColorBrush x:Key="Osk.PrimaryKeyBackground"   Color="#FF4A76E8"/>
          <SolidColorBrush x:Key="Osk.PrimaryKeyBorder"       Color="#FF4A76E8"/>
          <SolidColorBrush x:Key="Osk.PrimaryKeyForeground"   Color="#FFFFFFFF"/>

          <!-- активные переключатели (CAPS) -->
          <SolidColorBrush x:Key="Osk.ActiveKeyBackground"    Color="#FFD0E8FF"/>

          <!-- Наведение/нажатие: НЕПРОЗРАЧНЫЕ цвета. Раньше нажатие делало клавишу полупрозрачной
               (Opacity), а тема Fluent подменяла её фон своим полупрозрачным — сквозь клавишу было
               видно экран под клавиатурой. -->
          <SolidColorBrush x:Key="Osk.KeyHoverBackground"          Color="#FFEDEDED"/>
          <SolidColorBrush x:Key="Osk.KeyPressedBackground"        Color="#FFD4D4D4"/>
          <SolidColorBrush x:Key="Osk.PrimaryKeyHoverBackground"   Color="#FF3F6AD8"/>
          <SolidColorBrush x:Key="Osk.PrimaryKeyPressedBackground" Color="#FF3358BC"/>
        </ResourceDictionary>

        <!-- Тёмная тема -->
        <ResourceDictionary x:Key="Dark">
          <!-- Непрозрачный: полупрозрачный фон показывал экран сквозь клавиатуру. -->
          <SolidColorBrush x:Key="Osk.Background"             Color="#FF101010"/>
          <SolidColorBrush x:Key="Osk.Border"                 Color="#40FFFFFF"/>

          <SolidColorBrush x:Key="Osk.KeyBackground"          Color="#303030"/>
          <SolidColorBrush x:Key="Osk.KeyBorder"              Color="#55FFFFFF"/>
          <SolidColorBrush x:Key="Osk.KeyForeground"          Color="#FFFFFFFF"/>

          <SolidColorBrush x:Key="Osk.PrimaryKeyBackground"   Color="#FF3050A0"/>
          <SolidColorBrush x:Key="Osk.PrimaryKeyBorder"       Color="#FF80A0FF"/>
          <SolidColorBrush x:Key="Osk.PrimaryKeyForeground"   Color="#FFFFFFFF"/>

          <SolidColorBrush x:Key="Osk.ActiveKeyBackground"    Color="#FF4060C0"/>

          <SolidColorBrush x:Key="Osk.KeyHoverBackground"          Color="#FF3A3A3A"/>
          <SolidColorBrush x:Key="Osk.KeyPressedBackground"        Color="#FF4A4A4A"/>
          <SolidColorBrush x:Key="Osk.PrimaryKeyHoverBackground"   Color="#FF3858AC"/>
          <SolidColorBrush x:Key="Osk.PrimaryKeyPressedBackground" Color="#FF26448C"/>
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>

    <!-- Контейнер клавиатуры -->
    <Style Selector="local|OnScreenKeyboard">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="4"/>

      <Setter Property="Background" Value="{DynamicResource Osk.Background}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Osk.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Базовый стиль для всех клавиш -->
    <Style Selector="local|OnScreenKeyboard Button.osk-button">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="Padding" Value="6,4"/>

      <!-- Центрируем текст -->
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>

      <!-- Растяжение по ячейке -->
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>

      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BorderThickness" Value="1"/>

      <!-- Цвета берём из ресурсов OSK -->
      <Setter Property="Background" Value="{DynamicResource Osk.KeyBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Osk.KeyBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.KeyForeground}"/>
    </Style>

    <!-- Основные клавиши (Enter / Cancel / Backspace / Del / Eng / Rus) -->
    <Style Selector="local|OnScreenKeyboard Button.osk-button.primary">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="{DynamicResource Osk.PrimaryKeyBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Osk.PrimaryKeyBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.PrimaryKeyForeground}"/>
    </Style>

    <!-- Активные переключатели (CAPS) -->
    <Style Selector="local|OnScreenKeyboard Button.osk-button.active">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Background" Value="{DynamicResource Osk.ActiveKeyBackground}"/>
    </Style>

    <!-- «Широкие» кнопки (Space, Caps) -->
    <Style Selector="local|OnScreenKeyboard Button.osk-button.wide">
      <Setter Property="FontSize" Value="16"/>
    </Style>

    <!-- Hover / Pressed -->
    <Style Selector="local|OnScreenKeyboard Button.osk-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Osk.KeyHoverBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Osk.KeyBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.KeyForeground}"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard Button.osk-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Osk.KeyPressedBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Osk.KeyBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.KeyForeground}"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard Button.osk-button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Osk.PrimaryKeyHoverBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Osk.PrimaryKeyBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.PrimaryKeyForeground}"/>
    </Style>
    <Style Selector="local|OnScreenKeyboard Button.osk-button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Osk.PrimaryKeyPressedBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Osk.PrimaryKeyBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource Osk.PrimaryKeyForeground}"/>
    </Style>

  </UserControl.Styles>

  <!-- Background="Transparent": без фона зазоры между клавишами не ловят касание, оно уходит
       на экран под клавиатурой, фокус теряется — и клавиатура закрывается. -->
  <Grid x:Name="KeysGrid"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
        ColumnDefinitions="*"
        Background="Transparent">
    <UniformGrid Rows="1" Columns="9"  Grid.Row="0" x:Name="Row0" />
    <UniformGrid Rows="1" Columns="10" Grid.Row="1" x:Name="Row1" />
    <UniformGrid Rows="1" Columns="10" Grid.Row="2" x:Name="Row2" />
    <UniformGrid Rows="1" Columns="9"  Grid.Row="3" x:Name="Row3" />
    <UniformGrid Rows="1" Columns="9"  Grid.Row="4" x:Name="Row4" />
    <UniformGrid Rows="1" Columns="5"  Grid.Row="5" x:Name="Row5" />
  </Grid>
</UserControl>
