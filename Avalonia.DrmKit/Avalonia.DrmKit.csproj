<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- ВАЖНО: PackageId без префикса Avalonia.* -->
		<PackageId>DrmKit.Avalonia</PackageId>
		<Version>12.1.1-proto.2</Version>

		<Authors>bezdar-yakoo</Authors>

		<Description>
			Utilities for running Avalonia apps on Linux DRM/Framebuffer:
			evdev keyboard (EN/RU, Alt+Shift, CapsLock), on-screen keyboard,
			soft cursor with auto-hide and pointerover fix, evdev mouse fallback.
		</Description>

		<PackageTags>
			avalonia;drm;linux;framebuffer;evdev;input;onscreen keyboard;soft cursor;kiosk
		</PackageTags>

		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/bezdar-yakoo/Avalonia.DrmKit</RepositoryUrl>
		<PackageProjectUrl>https://github.com/bezdar-yakoo/Avalonia.DrmKit</PackageProjectUrl>
		<PackageReadmeFile>README.NuGet.md</PackageReadmeFile>

		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<IsPackable>true</IsPackable>

		<PackageIcon>icon.png</PackageIcon>
		<PackageReleaseNotes>
			On-screen keyboard: new looks next to the classic one, chosen with
			OnScreenKeyboardStyle.TextVariant / DigitVariant (both default to
			Classic, so nothing changes for an app that does not set them).
			Letters, Phone: shift and backspace at the ends of the third row,
			digits and punctuation on a "?123" layer, a wide space bar, "Done"
			at the end of the bottom row, "Undo changes" in a strip above the
			keys. Digits: Calculator (7-8-9 on top, a wide 0, the decimal
			separator next to it, a tall "Done" on the right), TwoRows (two rows
			of five digits, the lowest pad) and Pad (4x4). The decimal separator
			follows the culture; in whole-number fields its key stays in place
			dimmed. The strip shows the field name, its limits and the value
			before editing (OnScreenKeyboardField.Title / Hint); one-shot shift
			and auto-capitalised names (CapitalizeWords); the UI language first;
			the full Russian alphabet. App-like colours, light and dark.
		</PackageReleaseNotes>
	</PropertyGroup>

	<PropertyGroup>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
		<Avalonia_I_Want_To_Use_Private_Apis_In_Nuget_Package_And_Promise_To_Pin_The_Exact_Avalonia_Version_In_Package_Dependency>true</Avalonia_I_Want_To_Use_Private_Apis_In_Nuget_Package_And_Promise_To_Pin_The_Exact_Avalonia_Version_In_Package_Dependency>
	</PropertyGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="Avalonia.DrmKit.Tests" />
	</ItemGroup>

	<!-- README лежит рядом с этим .csproj -->
	<ItemGroup>
		<None Include="README.NuGet.md" Pack="true" PackagePath="" />
		<None Include="icon.png" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.0.4" />
		<PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
		<PackageReference Include="Avalonia.LinuxFramebuffer" Version="12.0.4" />
		<PackageReference Include="ReactiveUI.Avalonia" Version="12.0.3" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.300" PrivateAssets="All" />
	</ItemGroup>
</Project>
