<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- ВАЖНО: PackageId без префикса Avalonia.* -->
		<PackageId>DrmKit.Avalonia</PackageId>
		<Version>12.0.6</Version>

		<Authors>bezdar-yakoo</Authors>

		<Description>
			Utilities for running Avalonia apps on Linux DRM/Framebuffer:
			evdev keyboard (EN/RU, Alt+Shift, CapsLock), on-screen keyboard,
			soft cursor with auto-hide and pointerover fix, evdev mouse fallback.
		</Description>

		<PackageTags>
			avalonia;drm;linux;framebuffer;evdev;input;onscreen keyboard;soft cursor;kiosk
		</PackageTags>

		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/bezdar-yakoo/Avalonia.DrmKit</RepositoryUrl>
		<PackageProjectUrl>https://github.com/bezdar-yakoo/Avalonia.DrmKit</PackageProjectUrl>
		<PackageReadmeFile>README.NuGet.md</PackageReadmeFile>

		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<IsPackable>true</IsPackable>

		<PackageIcon>icon.png</PackageIcon>
		<PackageReleaseNotes>
			Multitouch: evdev MT protocol B support (ABS_MT_SLOT per-slot contact
			tracking, frame commit on SYN_REPORT, stable per-contact tracking ids).
			Single-touch emulation is suppressed on MT-slot devices; devices without
			slots keep the previous single-touch behavior. Jitter/tap filtering
			applies only while one contact is active so pinch gestures get raw
			points. SYN_DROPPED cancels all active contacts. Only the primary
			contact drives the soft cursor.
		</PackageReleaseNotes>
	</PropertyGroup>

	<PropertyGroup>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
		<Avalonia_I_Want_To_Use_Private_Apis_In_Nuget_Package_And_Promise_To_Pin_The_Exact_Avalonia_Version_In_Package_Dependency>true</Avalonia_I_Want_To_Use_Private_Apis_In_Nuget_Package_And_Promise_To_Pin_The_Exact_Avalonia_Version_In_Package_Dependency>
	</PropertyGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="Avalonia.DrmKit.Tests" />
	</ItemGroup>

	<!-- README лежит рядом с этим .csproj -->
	<ItemGroup>
		<None Include="README.NuGet.md" Pack="true" PackagePath="" />
		<None Include="icon.png" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.0.4" />
		<PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
		<PackageReference Include="Avalonia.LinuxFramebuffer" Version="12.0.4" />
		<PackageReference Include="ReactiveUI.Avalonia" Version="12.0.3" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.300" PrivateAssets="All" />
	</ItemGroup>
</Project>
